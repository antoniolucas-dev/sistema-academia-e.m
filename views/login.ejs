<%- include("partials/header", { titulo: "Login" }) %>

<div class="login-container">

    <form action="/auth/login" method="POST" class="login-form">

        <div class="login-form-header">
            <div class="login-logo">
                <i class="fa-solid fa-dumbbell"></i>
            </div>
            <h2>Entrar</h2>
            <p>Faça login para acessar sua conta</p>
        </div>

        <% if (typeof erro !== 'undefined' && erro) { %>
            <div class="alerta alerta-erro"><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
        <% } %>

        <% if (typeof sucesso !== 'undefined' && sucesso) { %>
            <div class="alerta alerta-sucesso"><i class="fa-solid fa-circle-check"></i> <%= sucesso %></div>
        <% } %>

        <div class="input-group">
            <label for="email">E-mail</label>
            <div class="input-wrapper">
                <i class="fa-solid fa-envelope input-icone"></i>
                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="seu@email.com"
                    required
                >
            </div>
        </div>

        <div class="input-group">
            <label for="senha">Senha</label>
            <div class="input-wrapper">
                <i class="fa-solid fa-lock input-icone"></i>
                <input
                    type="password"
                    id="senha"
                    name="senha"
                    placeholder="Sua senha"
                    required
                >
                <button type="button" class="input-toggle" onclick="toggleSenha(this)">
                    <i class="fa-solid fa-eye"></i>
                </button>
            </div>
        </div>

        <button type="submit" class="btn-login">
            Entrar
            <i class="fa-solid fa-arrow-right"></i>
        </button>

        <p class="login-form-rodape">
            Ainda não tem conta? <a href="/cadastro">Criar conta</a>
        </p>

    </form>

</div>

<script>
    function toggleSenha(btn) {
        const input = btn.parentElement.querySelector('input');
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'fa-solid fa-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'fa-solid fa-eye';
        }
    }
</script>

<%- include("partials/footer") %>
