<%- include("partials/header", { titulo: "Treinos" }) %>

<%- include("partials/navbar") %>

<div class="container">

    <%- include("partials/sidebar") %>

    <main class="content">

        <div class="page-header">

            <h1>Treinos</h1>

            <a href="/treinos/novo" class="btn">
                Novo Treino
            </a>

        </div>

        <table class="table">

            <thead>

                <tr>
                    <th>Nome</th>
                    <th>Categoria</th>
                    <th>Duração</th>
                    <th>Ações</th>
                </tr>

            </thead>

            <tbody>

                <% if (treinos && treinos.length > 0) { %>

                    <% treinos.forEach(treino => { %>

                        <tr>

                            <td class="aluno-nome"><%= treino.nome %></td>

                            <td><span class="badge-categoria"><%= treino.categoria %></span></td>

                            <td><span class="treino-duracao"><%= treino.duracao %> min</span></td>

                            <td>

                                <div class="acoes-container">
                                    <a href="/treinos/editar/<%= treino.id %>" class="btn-edit">
                                        Editar
                                    </a>

                                    <a href="/treinos/excluir/<%= treino.id %>" class="btn-delete">
                                        Excluir
                                    </a>
                                </div>

                            </td>

                        </tr>

                    <% }) %>

                <% } else { %>

                    <tr>

                        <td colspan="4">
                            Nenhum treino cadastrado.
                        </td>

                    </tr>

                <% } %>

            </tbody>

        </table>

    </main>

</div>

<%- include("partials/footer") %>