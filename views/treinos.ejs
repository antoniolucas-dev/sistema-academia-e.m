<%- include("partials/header", { titulo: "Treinos" }) %>

<%- include("partials/navbar") %>

<div class="container">

    <%- include("partials/sidebar") %>

    <main class="content">

        <div class="page-header">

            <h1>Treinos</h1>

            <% if (usuario && usuario.tipo !== 'Aluno') { %>
                <a href="/treinos/novo" class="btn">
                    Novo Treino
                </a>
            <% } %>

        </div>

        <% if (usuario && usuario.tipo === 'Aluno' && !meuAluno) { %>
            <p style="color: var(--text-muted);">
                Sua conta ainda não está vinculada a um cadastro de aluno matriculado, então nenhum treino pode
                ser exibido aqui. Peça para um professor ou administrador fazer o vínculo.
            </p>
        <% } %>

        <table class="table">

            <thead>

                <tr>
                    <th>Nome</th>
                    <th>Categoria</th>
                    <th>Duração</th>
                    <% if (usuario && usuario.tipo !== 'Aluno') { %>
                        <th>Atribuído a</th>
                        <th>Ações</th>
                    <% } else { %>
                        <th>Status</th>
                    <% } %>
                </tr>

            </thead>

            <tbody>

                <% if (treinos && treinos.length > 0) { %>

                    <% treinos.forEach(treino => { %>

                        <tr>

                            <td class="aluno-nome"><%= treino.nome %></td>

                            <td><span class="badge-categoria"><%= treino.categoria %></span></td>

                            <td><span class="treino-duracao"><%= treino.duracao %> min</span></td>

                            <% if (usuario && usuario.tipo !== 'Aluno') { %>

                                <td>
                                    <% const idsAtribuidos = treino.alunosIds || []; %>
                                    <% if (idsAtribuidos.length > 0) { %>
                                        <span class="treino-duracao">
                                            <%= idsAtribuidos.length %>
                                            <%= idsAtribuidos.length === 1 ? 'aluno' : 'alunos' %>
                                            (<%= totalConcluidosPorTreino[treino.id] || 0 %> concluíram)
                                        </span>
                                    <% } else { %>
                                        <span class="treino-duracao">Ninguém ainda</span>
                                    <% } %>
                                </td>

                                <td>
                                    <div class="acoes-container">
                                        <a href="/treinos/editar/<%= treino.id %>" class="btn-edit">
                                            Editar
                                        </a>

                                        <a href="/treinos/excluir/<%= treino.id %>" class="btn-delete">
                                            Excluir
                                        </a>
                                    </div>
                                </td>

                            <% } else { %>

                                <td>
                                    <% const concluido = concluidosIds.includes(treino.id); %>
                                    <% if (concluido) { %>
                                        <div class="acoes-container">
                                            <span class="badge" style="background: var(--success-soft); color: var(--success);">
                                                Concluído
                                            </span>
                                            <a href="/treinos/desmarcar/<%= treino.id %>" class="btn-edit">
                                                Desmarcar
                                            </a>
                                        </div>
                                    <% } else { %>
                                        <a href="/treinos/concluir/<%= treino.id %>" class="btn">
                                            Marcar como concluído
                                        </a>
                                    <% } %>
                                </td>

                            <% } %>

                        </tr>

                    <% }) %>

                <% } else { %>

                    <tr>

                        <td colspan="<%= usuario && usuario.tipo !== 'Aluno' ? 5 : 4 %>">
                            <% if (usuario && usuario.tipo === 'Aluno' && meuAluno) { %>
                                Nenhum treino foi atribuído a você ainda.
                            <% } else { %>
                                Nenhum treino cadastrado.
                            <% } %>
                        </td>

                    </tr>

                <% } %>

            </tbody>

        </table>

    </main>

</div>

<%- include("partials/footer") %>