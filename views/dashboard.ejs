<%- include("partials/header", { titulo: "Dashboard" }) %>
<%- include("partials/navbar") %>

<div class="container">
    <%- include("partials/sidebar") %>
    <main class="content">
        <div class="page-header">
            <div>
                <h1>Dashboard</h1>
                <p>
                    <% if (usuario && usuario.tipo === 'Aluno') { %>
                        O que você precisa fazer hoje.
                    <% } else { %>
                        Visão geral da academia em tempo real.
                    <% } %>
                </p>
            </div>
            <div id="current-date" style="color: var(--text-muted);"></div>
        </div>

        <% if (usuario && usuario.tipo === 'Aluno') { %>

            <div class="perfil-header" style="margin-bottom: 1.5rem;">
                <div class="perfil-info">
                    <h1 style="margin-bottom: 0.25rem;"><%= saudacao %>, <%= usuario.nome.split(' ')[0] %>! 👋</h1>
                    <% if (meuAluno) { %>
                        <span class="badge-faixa"><%= meuAluno.faixa %></span>
                    <% } %>
                </div>
            </div>

            <div class="card" style="margin-bottom: 1.5rem;">
                <h3 style="margin-bottom: 1rem;">
                    <i class="fa-solid fa-bolt"></i>
                    <%= proximoTreino ? 'Seu próximo treino' : 'Você está em dia' %>
                </h3>

                <% if (proximoTreino) { %>
                    <div class="treino-mini-card" style="margin-bottom: 1rem;">
                        <span class="treino-nome"><%= proximoTreino.nome %></span>
                        <span class="treino-categoria"><%= proximoTreino.categoria %></span>
                        <span class="treino-duracao">
                            <i class="fa-solid fa-clock"></i>
                            <%= proximoTreino.duracao %> min
                        </span>
                    </div>
                    <a href="/treinos/concluir/<%= proximoTreino.id %>?voltar=dashboard" class="btn">
                        <i class="fa-solid fa-check"></i> Marcar como concluído
                    </a>
                <% } else if (!meuAluno) { %>
                    <p style="color: var(--text-muted);">Seu usuário ainda não está vinculado a uma matrícula de aluno. Fale com a recepção.</p>
                <% } else { %>
                    <p style="color: var(--text-muted);">Você concluiu todos os treinos atribuídos. Bom trabalho! 🎉</p>

                    <% if (ultimoTreino && ultimoTreino.aindaAtribuido) { %>
                        <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border);">
                            <p style="color: var(--text-muted); margin-bottom: 0.75rem;">Quer treinar de novo hoje?</p>
                            <a href="/treinos/repetir/<%= ultimoTreino.treino.id %>" class="btn-edit">
                                <i class="fa-solid fa-rotate-right"></i> Repetir "<%= ultimoTreino.treino.nome %>"
                            </a>
                        </div>
                    <% } %>
                <% } %>
            </div>

            <div class="card" style="margin-bottom: 1.5rem;">
                <h3 style="margin-bottom: 1rem;"><i class="fa-solid fa-calendar-week"></i> Sua semana</h3>
                <div style="display: flex; justify-content: space-between; gap: 0.5rem;">
                    <% frequenciaSemana.forEach(dia => { %>
                        <div style="display: flex; flex-direction: column; align-items: center; gap: 0.4rem; flex: 1;">
                            <span style="font-size: 0.75rem; color: var(--text-muted);"><%= dia.label %></span>
                            <div style="
                                width: 34px; height: 34px; border-radius: 50%;
                                display: flex; align-items: center; justify-content: center;
                                --bg-dia: <%= dia.treinou ? 'var(--primary)' : 'var(--bg-input)' %>;
                                --border-dia: <%= dia.hoje ? 'var(--primary)' : 'var(--border)' %>;
                                background: var(--bg-dia);
                                border: 1px solid var(--border-dia);
                            ">
                                <% if (dia.treinou) { %>
                                    <i class="fa-solid fa-check" style="font-size: 0.7rem; color: #fff;"></i>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>

            <% if (treinoFavorito) { %>
            <div class="card" style="margin-bottom: 1.5rem;">
                <h3 style="margin-bottom: 0.5rem;"><i class="fa-solid fa-star"></i> Seu treino favorito</h3>
                <p style="color: var(--text-muted);">
                    <strong style="color: var(--text-main);"><%= treinoFavorito.nome %></strong>
                    — concluído <%= treinoFavorito.vezes %> <%= treinoFavorito.vezes === 1 ? 'vez' : 'vezes' %>
                </p>
            </div>
            <% } %>

            <% if (outrosPendentes.length > 0) { %>
            <div class="card">
                <h3 style="margin-bottom: 1rem;">Outros treinos pendentes (<%= outrosPendentes.length %>)</h3>

                <% if (pendentesPorCategoria.length > 1) { %>
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem;">
                    <% pendentesPorCategoria.forEach(grupo => { %>
                        <span class="treino-categoria"><%= grupo.categoria %>: <%= grupo.quantidade %></span>
                    <% }) %>
                </div>
                <% } %>

                <div class="proximo-treino-lista">
                    <% outrosPendentes.forEach(treino => { %>
                        <div class="treino-mini-card">
                            <span class="treino-nome"><%= treino.nome %></span>
                            <span class="treino-categoria"><%= treino.categoria %></span>
                            <span class="treino-duracao">
                                <i class="fa-solid fa-clock"></i>
                                <%= treino.duracao %> min
                            </span>
                        </div>
                    <% }) %>
                </div>
            </div>
            <% } %>

            <div class="card" style="margin-top: 1.5rem;">
                <h3 style="margin-bottom: 1rem;">Acesso rápido</h3>
                <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                    <a href="/treinos" class="btn"><i class="fa-solid fa-dumbbell"></i> Meus Treinos</a>
                    <a href="/exercicios" class="btn"><i class="fa-solid fa-person-running"></i> Exercícios</a>
                    <a href="/perfil" class="btn"><i class="fa-solid fa-chart-bar"></i> Ver meu progresso completo</a>
                </div>
            </div>

        <% } else { %>

            <div class="dashboard-cards">
                <div class="card">
                    <i class="fa-solid fa-users card-icone"></i>
                    <p class="estatistica-valor" id="stat-alunos" data-valor-final="0">0</p>
                    <p class="card-label">Total de Alunos</p>
                </div>

                <div class="card">
                    <i class="fa-solid fa-dumbbell card-icone"></i>
                    <p class="estatistica-valor" id="stat-treinos" data-valor-final="0">0</p>
                    <p class="card-label">Treinos Cadastrados</p>
                </div>

                <div class="card">
                    <i class="fa-solid fa-person-running card-icone"></i>
                    <p class="estatistica-valor" id="stat-exercicios" data-valor-final="0">0</p>
                    <p class="card-label">Exercícios Cadastrados</p>
                </div>
            </div>

            <div class="card">
                <h3 style="margin-bottom: 1rem;">Acesso rápido</h3>
                <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                    <a href="/alunos" class="btn"><i class="fa-solid fa-users"></i> Alunos</a>
                    <a href="/treinos" class="btn"><i class="fa-solid fa-dumbbell"></i> Treinos</a>
                    <a href="/exercicios" class="btn"><i class="fa-solid fa-person-running"></i> Exercícios</a>
                </div>
            </div>

            <script>
                fetch('/api/stats')
                    .then(function (resposta) { return resposta.json(); })
                    .then(function (dados) {
                        document.getElementById('stat-alunos').textContent = dados.totalAlunos;
                        document.getElementById('stat-treinos').textContent = dados.totalTreinos;
                        document.getElementById('stat-exercicios').textContent = dados.totalExercicios;
                    })
                    .catch(function (erro) { console.error('Não foi possível carregar as estatísticas:', erro); });
            </script>

        <% } %>
    </main>
</div>

<script>
    document.getElementById('current-date').innerText = new Date().toLocaleDateString('pt-BR', {
        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
    });
</script>

<%- include("partials/footer") %>