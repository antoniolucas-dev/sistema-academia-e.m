<%- include("partials/header", { titulo: "Informações" }) %>
<%- include("partials/navbar") %>

<div class="container">
    <%- include("partials/sidebar") %>
    <main class="content">
        <div class="page-header">
            <div>
                <h1>Informações Institucionais</h1>
                <p>Detalhes operacionais, planos e canais de atendimento da Academia E.M.</p>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
            
            <!-- Horário -->
            <div class="card">
                <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 1rem;">
                    <i class="fa-solid fa-clock" style="color: var(--primary);"></i>
                    <h3>Funcionamento</h3>
                </div>
                <div style="display: flex; flex-direction: column; gap: 0.75rem; color: var(--text-muted);">
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">
                        <span>Segunda a Sexta</span>
                        <span style="color: #fff;">06h às 22h</span>
                    </div>
                    <!-- Adicione os outros horários seguindo o mesmo padrão -->
                </div>
            </div>

            <!-- Planos -->
            <div class="card">
                <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 1rem;">
                    <i class="fa-solid fa-tags" style="color: var(--primary);"></i>
                    <h3>Planos de Adesão</h3>
                </div>
                <!-- Planos com bordas e ícones de destaque -->
            </div>

            <!-- Contato -->
            <div class="card">
                <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 1rem;">
                    <i class="fa-solid fa-headset" style="color: var(--primary);"></i>
                    <h3>Atendimento</h3>
                </div>
                <!-- Links de Instagram, E-mail e Telefone -->
            </div>

            <!-- Localização -->
            <div class="card">
                <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 1rem;">
                    <i class="fa-solid fa-location-dot" style="color: var(--primary);"></i>
                    <h3>Localização</h3>
                </div>
                <button class="btn" style="width: 100%; background: rgba(255,255,255,0.05);">
                    VER NO MAPA
                </button>
            </div>
        </div>
    </main>
</div>
<%- include("partials/footer") %>