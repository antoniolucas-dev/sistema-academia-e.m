<%- include("partials/header", { titulo: "Editar Perfil" }) %>

<%- include("partials/navbar") %>

<div class="container">

    <%- include("partials/sidebar") %>

    <main class="content">

        <h1>Editar Perfil</h1>

        <% if (typeof erro !== 'undefined' && erro) { %>
            <div class="alerta alerta-erro"><%= erro %></div>
        <% } %>

        <form action="/perfil/salvar" method="POST" enctype="multipart/form-data" class="form">

            <% if (usuario.foto) { %>
                <img src="<%= usuario.foto %>" alt="Foto de perfil" class="perfil-foto">
            <% } %>

            <label for="foto">Foto de perfil</label>
            <input type="file" id="foto" name="foto" accept="image/png, image/jpeg, image/webp">

            <label for="nome">Nome</label>
            <input type="text" id="nome" name="nome" value="<%= usuario.nome %>" required>

            <label for="telefone">Telefone</label>
            <input type="text" id="telefone" name="telefone" value="<%= usuario.telefone || '' %>">

            <button class="btn" type="submit">Salvar Alterações</button>

        </form>

    </main>

</div>

<%- include("partials/footer") %>