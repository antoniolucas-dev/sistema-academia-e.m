<%- include("partials/header", { titulo: "Editar Perfil" }) %>

<%- include("partials/navbar") %>

<div class="container">


    <main class="content">

        <div class="page-header" style="max-width: 600px; margin: 0 auto 2rem auto;">
            <div>
                <h1><i class="fa-solid fa-user-pen" style="color: var(--primary); margin-right: 10px;"></i>Editar Perfil</h1>
                <p>Atualize suas informações pessoais</p>
            </div>
            <a href="/perfil" class="btn" style="background: var(--bg-card); color: var(--text-main); box-shadow: none; border: 1px solid var(--border);">
                <i class="fa-solid fa-arrow-left"></i>
                Voltar ao Perfil
            </a>
        </div>

        <% if (typeof erro !== 'undefined' && erro) { %>
            <div class="alerta alerta-erro"><i class="fa-solid fa-triangle-exclamation" style="margin-right: 0.5rem;"></i> <%= erro %></div>
        <% } %>

        <div class="perfil-form-container">
            <form action="/perfil/salvar" method="POST" enctype="multipart/form-data" class="form">

                <div class="foto-upload">
                    <% if (usuario.foto) { %>
                        <img src="<%= usuario.foto %>" alt="Foto de perfil" class="foto-preview">
                    <% } else { %>
                        <div class="foto-preview" style="display: flex; align-items: center; justify-content: center; background: var(--primary-soft);">
                            <i class="fa-solid fa-user" style="font-size: 2rem; color: var(--primary);"></i>
                        </div>
                    <% } %>
                    <div class="foto-upload-info">
                        <label for="foto" style="cursor: pointer; color: var(--primary); font-weight: 600;">
                            <i class="fa-solid fa-camera"></i>
                            Alterar foto de perfil
                        </label>
                        <input type="file" id="foto" name="foto" accept="image/png, image/jpeg, image/webp" style="display: none;" onchange="previewFoto(this)">
                        <p>JPG, PNG ou WebP — Máximo 5MB</p>
                    </div>
                </div>

                <div class="form-group">
                    <label for="nome"><i class="fa-solid fa-user" style="margin-right: 0.4rem; color: var(--text-faint);"></i> Nome</label>
                    <input type="text" id="nome" name="nome" value="<%= usuario.nome %>" required>
                </div>

                <div class="form-group">
                    <label for="email"><i class="fa-solid fa-envelope" style="margin-right: 0.4rem; color: var(--text-faint);"></i> Email</label>
                    <input type="email" value="<%= usuario.email %>" disabled style="opacity: 0.6; cursor: not-allowed;">
                    <small style="font-size: 0.75rem; color: var(--text-faint);">O email não pode ser alterado</small>
                </div>

                <div class="form-group">
                    <label for="telefone"><i class="fa-solid fa-phone" style="margin-right: 0.4rem; color: var(--text-faint);"></i> Telefone</label>
                    <input type="text" id="telefone" name="telefone" value="<%= usuario.telefone || '' %>" placeholder="(00) 00000-0000">
                </div>

                <% if (usuario.tipo === 'Aluno') { %>
                <div class="form-group">
                    <label for="metaMensal">
                        <i class="fa-solid fa-bullseye" style="margin-right: 0.4rem; color: var(--primary);"></i>
                        Meta mensal de treinos
                    </label>
                    <input type="number" id="metaMensal" name="metaMensal" value="<%= usuario.metaMensal || 12 %>" min="1" max="365" placeholder="12">
                    <small style="font-size: 0.75rem; color: var(--text-faint);">Defina quantos treinos você quer realizar por mês</small>
                </div>
                <% } %>

                <button class="btn" type="submit" style="margin-top: 0.5rem;">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Salvar Alterações
                </button>

            </form>
        </div>

    </main>

</div>

<script>
    function previewFoto(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const preview = document.querySelector('.foto-preview');
                if (preview.tagName === 'IMG') {
                    preview.src = e.target.result;
                } else {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.className = 'foto-preview';
                    img.alt = 'Prévia da foto';
                    preview.replaceWith(img);
                }
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>

<%- include("partials/footer") %>
