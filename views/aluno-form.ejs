<%- include("partials/header", { titulo: aluno ? "Editar Aluno" : "Cadastrar Aluno" }) %>
<%- include("partials/navbar") %>
<div class="container">
    <%- include("partials/sidebar") %>
    <main class="content">
        <h1><%= aluno ? "Editar Aluno" : "Cadastrar Aluno" %></h1>
        <form action="/alunos/salvar" method="POST" class="form">
            <% if (aluno) { %>
                <input type="hidden" name="id" value="<%= aluno.id %>">
            <% } %>
            <label for="nome">Nome</label>
            <input type="text" id="nome" name="nome" value="<%= aluno ? aluno.nome : '' %>" required>
            <label for="email">E-mail</label>
            <input type="email" id="email" name="email" value="<%= aluno ? aluno.email : '' %>" required>
            <label for="telefone">Telefone</label>
            <input type="text" id="telefone" name="telefone" value="<%= aluno ? aluno.telefone : '' %>" required>
            <label for="faixa">Faixa</label>
            <select id="faixa" name="faixa">
                <% const faixas = ["Branca", "Cinza", "Amarela", "Laranja", "Verde", "Azul", "Roxa", "Marrom", "Preta"]; %>
                <% faixas.forEach(f => { %>
                    <option value="<%= f %>" <%= aluno && aluno.faixa === f ? 'selected' : '' %>><%= f %></option>
                <% }) %>
            </select>

            <label for="usuarioId">Vincular a uma conta de login (opcional)</label>
            <select id="usuarioId" name="usuarioId">
                <option value="">Nenhuma conta vinculada</option>
                <% contas.forEach(c => { %>
                    <option value="<%= c.id %>" <%= aluno && aluno.usuarioId === c.id ? 'selected' : '' %>>
                        <%= c.nome %> (<%= c.email %>)
                    </option>
                <% }) %>
            </select>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: -0.5rem;">
                Vincular permite que o próprio aluno veja sua faixa e telefone na área "Meu Perfil".
                Só aparecem aqui contas do tipo Aluno ainda não vinculadas a outro cadastro.
            </p>

            <button class="btn" type="submit"><%= aluno ? "Atualizar Aluno" : "Salvar Aluno" %></button>
        </form>
    </main>
</div>
<%- include("partials/footer") %>