<%- include("partials/header", { titulo: "Dashboard" } ) %>
<%- include("partials/navbar") %>
<div class="container">
    <%- include("partials/sidebar") %>
    <main class="content">
        <div class="page-header">
            <h1>Dashboard</h1>
            <div id="current-date" style="color: var(--text-muted);"></div>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem;">
            <div class="card">
                <i class="fa-solid fa-users" style="font-size: 2rem; color: var(--primary);"></i>
                <h3>Total de Alunos</h3>
                <p style="font-size: 2rem; font-weight: 700;">248</p>
            </div>
            <!-- Adicione outros cards seguindo o mesmo padrão -->
        </div>
    </main>
</div>
<script>
    document.getElementById('current-date').innerText = new Date().toLocaleDateString('pt-BR', {
        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
    });
</script>