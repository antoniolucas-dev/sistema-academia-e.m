<%- include("partials/header", { titulo: "Login" }) %>

<div class="login-container">

    <form action="/auth/login" method="POST" class="login-form">

        <h2>Login</h2>

        <input
            type="email"
            name="email"
            placeholder="E-mail"
            required
        >

        <input
            type="password"
            name="senha"
            placeholder="Senha"
            required
        >

        <button type="submit">
            Entrar
        </button>

    </form>

</div>

<%- include("partials/footer") %>
